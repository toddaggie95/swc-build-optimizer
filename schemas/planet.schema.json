{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "enum": [
            "geometry",
            "power",
            "terrain",
            "economics",
            "policy"
          ],
          "title": "Domain",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "id",
        "domain",
        "statement",
        "evidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AssumptionSet": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "assumptions"
      ],
      "title": "AssumptionSet",
      "type": "object"
    },
    "City": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 20,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 20,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "placements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "title": "Placements",
          "type": "array"
        },
        "designer_state": {
          "default": "",
          "pattern": "^(\\|[^|]*\\|[^|]*)?$",
          "title": "Designer State",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "City",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "user_confirmed",
            "documented",
            "empirical",
            "assumption",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source",
        "note"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "facility_id": {
          "minimum": 1,
          "title": "Facility Id",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "orientation": {
          "default": "v",
          "enum": [
            "v",
            "h"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "fixed": {
          "default": true,
          "title": "Fixed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "facility_id",
        "x",
        "y"
      ],
      "title": "Placement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Data contract only: no implicit economic formulas or default targets.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "cities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/City"
      },
      "title": "Cities",
      "type": "array"
    },
    "assumptions": {
      "$ref": "#/$defs/AssumptionSet"
    },
    "economic_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Economic Model Id"
    }
  },
  "required": [
    "name",
    "assumptions"
  ],
  "title": "PlanetScenario",
  "type": "object"
}
