{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdditionRequest": {
      "additionalProperties": false,
      "properties": {
        "facility_id": {
          "minimum": 1,
          "title": "Facility Id",
          "type": "integer"
        },
        "min_count": {
          "default": 0,
          "minimum": 0,
          "title": "Min Count",
          "type": "integer"
        },
        "max_count": {
          "minimum": 0,
          "title": "Max Count",
          "type": "integer"
        }
      },
      "required": [
        "facility_id",
        "max_count"
      ],
      "title": "AdditionRequest",
      "type": "object"
    },
    "City": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "width": {
          "default": 20,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 20,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "placements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "title": "Placements",
          "type": "array"
        },
        "designer_state": {
          "default": "",
          "pattern": "^(\\|[^|]*\\|[^|]*)?$",
          "title": "Designer State",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "City",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "facility_id": {
          "minimum": 1,
          "title": "Facility Id",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "orientation": {
          "default": "v",
          "enum": [
            "v",
            "h"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "fixed": {
          "default": true,
          "title": "Fixed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "facility_id",
        "x",
        "y"
      ],
      "title": "Placement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "city": {
      "$ref": "#/$defs/City"
    },
    "mode": {
      "default": "fixed",
      "enum": [
        "fixed",
        "free"
      ],
      "title": "Mode",
      "type": "string"
    },
    "goal": {
      "default": "feasibility",
      "enum": [
        "feasibility",
        "max_additions"
      ],
      "title": "Goal",
      "type": "string"
    },
    "additions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AdditionRequest"
      },
      "title": "Additions",
      "type": "array"
    },
    "locked_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Locked Ids",
      "type": "array"
    },
    "time_limit_seconds": {
      "default": 30.0,
      "exclusiveMinimum": 0,
      "title": "Time Limit Seconds",
      "type": "number"
    },
    "workers": {
      "default": 1,
      "maximum": 32,
      "minimum": 1,
      "title": "Workers",
      "type": "integer"
    },
    "random_seed": {
      "default": 0,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "use_hints": {
      "default": true,
      "title": "Use Hints",
      "type": "boolean"
    },
    "symmetry_breaking": {
      "default": true,
      "title": "Symmetry Breaking",
      "type": "boolean"
    }
  },
  "required": [
    "city"
  ],
  "title": "SolveRequest",
  "type": "object"
}
